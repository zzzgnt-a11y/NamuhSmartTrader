# NH투자증권 Namuh PLUG
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
NHPLUG_BASE_URL=https://api.nhplug.com:8443
NHPLUG_AUTH_URL=https://api.nhplug.com:8443

# 실제 주문은 이 프로젝트에서 사용하지 않습니다.
# 실계좌 보유종목을 AI 후보에서 제외하고 싶으면 계좌번호를 넣습니다.
NHPLUG_DEFAULT_ACCOUNT=

# 잔고 API 자동조회 실패 시 수동 보호코드(쉼표)
PROTECTED_CODES=

# 첫 실시간 구독/스캔 유니버스.
# 전체 KRX 종목을 한 WebSocket 세션에 다 넣을 수 없으므로,
# 서버는 아래 종목 + 동적 후보를 실시간 추적합니다.
TRACKED_CODES=005930,000660,035420,035720,068270,012450,042700,267260

# 해외/시장 대시보드 보조 데이터. 없으면 해당 카드는 연결대기로 둡니다.
# Yahoo chart는 시장별 지연이 있을 수 있어 AI 매매 신호에는 사용하지 않습니다.
ENABLE_MARKET_DASHBOARD_FALLBACK=1

# 선택: 공시/호재
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

HOST=0.0.0.0
PORT=8787
